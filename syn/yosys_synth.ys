#==============================================================================
# yosys_synth.ys — Open-source Yosys synthesis script for soc_top
#
# Usage:
#   yosys -s syn/yosys_synth.ys
#   make synth
#
# Produces:
#   build/synth/soc_top_synth.v   — gate-level netlist
#   build/synth/soc_top_stat.txt  — area / cell statistics
#==============================================================================

# Create output directory
shell mkdir -p build/synth

# Read all RTL sources
read_verilog -sv \
    rtl/core/pc_reg.sv \
    rtl/core/if_id_reg.sv \
    rtl/core/id_ex_reg.sv \
    rtl/core/ex_mem_reg.sv \
    rtl/core/mem_wb_reg.sv \
    rtl/core/regfile.sv \
    rtl/core/imm_gen.sv \
    rtl/core/alu.sv \
    rtl/core/control_unit.sv \
    rtl/core/hazard_unit.sv \
    rtl/core/forwarding.sv \
    rtl/core/cpu_core.sv \
    rtl/memory/imem.sv \
    rtl/memory/dmem.sv \
    rtl/memory/uart_tx.sv \
    rtl/soc_top.sv

# Elaborate hierarchy
hierarchy -check -top soc_top

# High-level synthesis passes
proc
opt
fsm
opt
memory
opt

# Generic technology mapping (no ASIC/FPGA library required for stats)
techmap
opt

# Report statistics
stat -width
tee -o build/synth/soc_top_stat.txt stat -width

# Write synthesizable Verilog netlist
write_verilog -noattr build/synth/soc_top_synth.v

# Done
puts "Yosys synthesis complete → build/synth/"
