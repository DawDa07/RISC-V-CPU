{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Make: sim (Verilator build)",
      "type": "shell",
      "command": "make sim",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Make: lint",
      "type": "shell",
      "command": "make lint",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Make: run sanity_add",
      "type": "shell",
      "command": "make run TEST=sanity_add",
      "group": "test",
      "dependsOn": "Make: sim (Verilator build)",
      "problemMatcher": []
    },
    {
      "label": "Make: run with VCD trace",
      "type": "shell",
      "command": "make run-trace TEST=sanity_add",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Make: assemble sanity_add",
      "type": "shell",
      "command": "make asm || make asm-fallback",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Make: Yosys synth",
      "type": "shell",
      "command": "make synth",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Make: clean",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    }
  ]
}
