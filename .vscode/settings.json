{
  "files.associations": {
    "*.sv": "systemverilog",
    "*.svh": "systemverilog",
    "*.v": "verilog"
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [80],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[systemverilog]": {
    "editor.defaultFormatter": "mshr-h.veriloghdl"
  },
  "verilog.linting.linter": "verilator",
  "verilog.linting.verilator.arguments":
    "--sv --timing -Wall -Wno-DECLFILENAME --top-module soc_top -Irtl -Irtl/core -Irtl/memory",
  "verilog.linting.path": "",
  "systemverilog.includeIndexing": [
    "rtl/**/*.sv"
  ],
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/tb/cpp",
    "${workspaceFolder}/build/sim"
  ]
}
